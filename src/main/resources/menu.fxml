<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.evnd.poo.bibliotecaproyec.controller.MenuController">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="barra">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label text="Sistema de Biblioteca" styleClass="barra-titulo"/>
            <Region prefWidth="30"/>
            <Button fx:id="btnAdministradores" text="Administradores" onAction="#onAdministradores" styleClass="boton-menu"/>
            <Button fx:id="btnLectores" text="Lectores" onAction="#onLectores" styleClass="boton-menu"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Joshua Odin Montoya Flores" styleClass="barra-autor"/>
            <Button text="Salir" onAction="#onSalir" styleClass="boton-menu"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contenedor"/>
    </center>
</BorderPane>
